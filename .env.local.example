# Verum Frontier — server-side environment variables
# Copy to .env.local for local dev. In production, set these in
# Vercel → Project → Settings → Environment Variables (paste them yourself;
# never commit real keys).

# Groq (free council: GPT-OSS 120B, GPT-OSS 20B, Qwen 3.8 27B) — console.groq.com
GROQ_API_KEY=

# Google Gemini — aistudio.google.com
GEMINI_API_KEY=

# Random secret for signing the free-tier quota cookie (any long random string)
QUOTA_SECRET=

# Validated BiasChecker v1 on RHAI infra (fail-open if unset/unreachable)
# Endpoint serves /health (open) and /score (bearer-gated)
BIAS_ENDPOINT=https://rhai-financial.duckdns.org/bias
# Token lives on the droplet in /opt/alice/app/.bias_env
BIAS_TOKEN=

# Ed25519 seal signing (pkcs8 der base64). Fail-open: unset -> seals unsigned.
SEAL_SIGNING_KEY=

# Stripe (test keys until the RHAI account is activated) — dashboard.stripe.com
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# RHAI Credits Ledger on .16 (token in /opt/alice/app/.credits_env)
CREDITS_ENDPOINT=https://rhai-financial.duckdns.org/credits
CREDITS_TOKEN=

# Model kill-switch: comma-separated GATE model ids (e.g. qwen3.8-27b) to hide
# from the boot list and refuse (503) until cleared. It can only REMOVE models —
# adding or swapping one is a code change, because its rate must be re-pinned in
# lib/pricing.ts first. Empty = every registry model is live.
VERUM_DISABLED_MODELS=

# Operator-only model health: GET /api/chat?health=1 with
# "Authorization: Bearer <MODEL_HEALTH_TOKEN>". At least 16 characters
# (e.g. `openssl rand -hex 32`). Unset = the health route answers 404.
MODEL_HEALTH_TOKEN=
# Optional: set CRON_SECRET too and a Vercel Cron job can call the same route
# (Vercel sends "Authorization: Bearer <CRON_SECRET>" automatically).
CRON_SECRET=
