# Verum Frontier — server-side environment variables
# Copy to .env.local for local dev. In production, set these in
# Vercel → Project → Settings → Environment Variables (paste them yourself;
# never commit real keys).

# Groq (free-tier Llama models) — console.groq.com
GROQ_API_KEY=

# Google Gemini — aistudio.google.com
GEMINI_API_KEY=

# Random secret for signing the free-tier quota cookie (any long random string)
QUOTA_SECRET=

# Validated BiasChecker v1 on RHAI infra (fail-open if unset/unreachable)
# Endpoint serves /health (open) and /score (bearer-gated)
BIAS_ENDPOINT=https://rhai-financial.duckdns.org/bias
# Token lives on the droplet in /opt/alice/app/.bias_env
BIAS_TOKEN=

# Ed25519 seal signing (pkcs8 der base64). Fail-open: unset -> seals unsigned.
SEAL_SIGNING_KEY=

# Stripe (test keys until the RHAI account is activated) — dashboard.stripe.com
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# RHAI Credits Ledger on .16 (token in /opt/alice/app/.credits_env)
CREDITS_ENDPOINT=https://rhai-financial.duckdns.org/credits
CREDITS_TOKEN=
